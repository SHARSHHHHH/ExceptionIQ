# Copy to backend/.env.local. Every value has a safe demo default.

# REQUIRED outside a local demo: a long random secret for signing session tokens.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: OpenAI features (planner, clause cross-check, role briefings, statement parsing).
# Without a key, every feature uses its deterministic engine. The key stays on the server.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini        # set to the model your organisation has approved
# PLANNER=openai                   # or "scripted" to force the deterministic planner

DATABASE_PATH=./data/exceptioniq.db
APPROVAL_TTL_MINUTES=1440
MAX_TOOL_CALLS=10
MAX_INVESTIGATION_MS=60000
ALLOWED_ORIGINS=http://localhost:5173

# Set to false to disable demo personas, reset and evidence-change simulation.
DEMO_MODE=true
